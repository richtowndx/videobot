# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot token (from @BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token

# OpenAI-compatible API key
OPENAI_API_KEY=your-openai-api-key

# ── OpenAI / LLM ─────────────────────────────────────────────────────────────

# Base URL for the OpenAI-compatible API (default: official OpenAI endpoint)
# OPENAI_API_BASE=https://api.openai.com/v1

# Chat-completion model name
# OPENAI_MODEL=gpt-4o

# Whisper model name for /audio/transcriptions (local Whisper uses "base", "small", etc.)
# WHISPER_MODEL=whisper-1

# ── Proxy ─────────────────────────────────────────────────────────────────────

# Optional proxy for Telegram API calls and yt-dlp downloads.
# Supports HTTP, HTTPS and SOCKS5 proxies.
# PROXY_URL=socks5://user:pass@127.0.0.1:1080

# ── Storage ───────────────────────────────────────────────────────────────────

# Root directory for notes and task files (default: ./data)
# DATA_DIR=data

# Days before a cached note is expired and re-generated (default: 30)
# NOTE_EXPIRE_DAYS=30

# Days before a task directory (audio, subtitles, transcript) is purged (default: 1)
# TASK_EXPIRE_DAYS=1

# ── Pipeline ──────────────────────────────────────────────────────────────────

# Maximum processing attempts per video link (default: 3)
# MAX_RETRIES=3
