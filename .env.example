# VideoBot 环境变量配置
# 复制此文件为 .env 并填写实际值

# === 必填 ===

# Telegram Bot Token（从 @BotFather 获取）
BOT_TOKEN=

# 授权用户 Telegram ID（仅此用户可使用 bot）
AUTH_USER_ID=0

# AI 模型配置（OpenAI 兼容接口）
AI_API_KEY=
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen-plus

# === 可选 ===

# Telegram Bot 代理（访问 Telegram API），留空则不使用代理
BOT_PROXY=

# YouTube 下载代理（访问 YouTube），留空则不使用代理
YT_PROXY=

# Bilibili Cookie 字符串（留空则使用 cookie_bilibili.txt 文件，文件也不存在则不设置）
BILIBILI_COOKIE=
# YouTube Cookie 字符串（留空则使用 cookie_ytb.txt 文件，文件也不存在则不设置）
YOUTUBE_COOKIE=

# Whisper 模型大小: tiny / base / small / medium
WHISPER_MODEL_SIZE=base

# 数据存储目录
DATA_DIR=./data
